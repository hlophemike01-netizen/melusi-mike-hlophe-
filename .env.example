# ---------------------------------------------------------------------------
# Mwhite SafeCircle environment variables
#
# Copy to `.env.local` and fill in. NEVER commit a filled-in copy.
# Anything prefixed NEXT_PUBLIC_ is bundled into the browser build and is
# therefore PUBLIC. Never put a secret behind that prefix.
# ---------------------------------------------------------------------------

# --- Supabase (public: safe to expose to the browser) ----------------------
# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The "anon"/publishable key. Safe in the browser ONLY because every table is
# protected by Row Level Security. Do not relax RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SECRET: server-only, never NEXT_PUBLIC_) --------------------
# Service role key. Bypasses RLS entirely. Used only by server-side code in
# `services/admin/*` and scheduled jobs. If this ever reaches the browser,
# every user's data is exposed. Leave blank locally unless you need the
# scheduled purge job.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mapbox ----------------------------------------------------------------
# Public access token (pk.*). Restrict it by URL in the Mapbox dashboard.
# Never use a secret token (sk.*) here.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional style override.
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/light-v11

# --- Application -----------------------------------------------------------
# Canonical site origin, used for auth redirect URLs (email confirmation,
# password reset). Must match a redirect URL allow-listed in Supabase Auth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret required by the scheduled location-purge endpoint
# (`POST /api/cron/purge-locations`). Generate with: openssl rand -hex 32
CRON_SECRET=
